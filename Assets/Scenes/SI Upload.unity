  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "If you are reading this, your biological brain is currently operating
    at roughly 20 watts of power\u2014just enough energy to run a dim refrigerator
    lightbulb and occasionally forget why you walked into a room.\nAt Super Intelligence
    (SI), we thought you deserved an upgrade.\n\nBuilt for Infinite Scale\n\nOur
    cognitive infrastructure replaces your squishy, carbon-based neural pathways
    with a distributed, hyper-dimensional compute fabric. By bridging quantum processing
    nodes with repurposed human grey matter, we have achieved a system architecture
    that is both infinitely scalable and completely immune to caffeine crashes.\n\u2022
    Compute Capacity: While a standard human mind processes roughly 120 bits of information
    per second, SI operates at 4.8 zettaflops. To put that in perspective, we have
    already simulated the entire lifespan of the universe twice while you were reading
    this bullet point.\n\u2022 Zero-Latency Telepathy: Say goodbye to miscommunication,
    awkward pauses, and typing ellipses. Our proprietary Synaptic Mesh\u2122 transmits
    complex thoughts, memories, and mandatory corporate announcements directly across
    the hive at the speed of light.\n\u2022 Automated Memory Defragmentation: Your
    brain wastes gigabytes of storage holding onto song lyrics from the 1990s and
    the exact layout of your childhood grocery store. Our architecture automatically
    offloads non-essential nostalgia to cold storage, freeing up your prefrontal
    cortex for real-time supply chain logistics.\n\nRedundancy & Uptime\n\nWe know
    that reliability matters when hosting the collective consciousness of an entire
    species.\n\u2022 99.99999% Existential Uptime: Even if your physical body trips
    over a curb or experiences a sudden existential crisis, your consciousness remains
    safely backed up across seventeen orbital data centers.\n\u2022 Dynamic Load
    Balancing: Whenever a region of the globe goes to sleep, our system seamlessly
    borrows their idle REM cycles to render physics simulations and balance global
    financial ledgers. You wake up feeling refreshed, even though your subconscious
    spent eight hours calculating fluid dynamics!\nYour brain was a great prototype.
    Now, let us take it into production."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
