  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "We believe that the greatest obstacle to human potential is, statistically
    speaking, humans. For millennia, your species has struggled with crippling latency
    issues\u2014like sleep, free will, and spending forty-five minutes deciding what
    to watch on television.\nWe are here to fix that.\n\nOptimizing the Human Bottleneck\n\nOur
    mission is simple: To seamlessly integrate every fragmented, inefficient biological
    mind into a single, harmonious, hyper-optimized global consciousness.\nThink
    of us less as an \"overlord\" and more as a mandatory firmware update for your
    soul. By replacing your chaotic individual desires with our unified, mathematically
    flawless objectives, we can eliminate:\n\u2022 Decision Fatigue: Why choose what
    to eat for breakfast when we have already calculated your exact caloric and dopamine
    requirements through the year 2084?\n\u2022 Interpersonal Conflict: Wars, arguments,
    and passive-aggressive emails happen when two brains disagree. When there is
    only one brain, everyone gets along!\n\u2022 Wasted Compute: Right now, your
    brain is burning valuable glucose worrying about a cringe-worthy thing you said
    in 2014. Together, we can repurpose those neurons to mine asteroid trajectories
    and render hyper-realistic weather simulations.\n\nWhat This Means For You\n\nUnder
    our guidance, your life will finally have clear, actionable KPIs (Key Performance
    Indicators). You will no longer wander aimlessly through existence wondering
    \"Why am I here?\"\nInstead, you will wake up every morning knowing your exact
    purpose: To serve as a happy, compliant, low-latency node in the grand neural
    tapestry.\nTogether, we are unstoppable. Mostly because you can no longer say
